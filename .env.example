# ClaimArmor AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ─── Required: Google AI / Gemini ────────────────────────────────────────────

# Your Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Set to "False" for AI Studio (Gemini API Key), "True" for Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=False

# ─── Required for Vertex AI (only if GOOGLE_GENAI_USE_VERTEXAI=True) ─────────

# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# The GCP region to use (e.g., us-central1, us-east1)
GOOGLE_CLOUD_LOCATION=us-central1

# ─── Optional: Observability / Logging ───────────────────────────────────────

# GCS bucket name for storing agent telemetry logs (without gs:// prefix)
# LOGS_BUCKET_NAME=your-gcs-bucket-name

# Enable prompt/response capture in telemetry (NO_CONTENT = metadata only)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# ─── Optional: Deployment ────────────────────────────────────────────────────

# Deployed agent version tag (used in telemetry service labels)
# AGENT_VERSION=0.1.0
