tests/load_test/.results/

# ----- Packaging / build -----
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ----- Logs -----
*.log

# ----- Django / Flask -----
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# ----- Translations -----
*.mo
*.pot

# ----- Docs -----
docs/_build/

# ----- IPython -----
profile_default/
ipython_config.py

# ----- pyenv -----
